#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
// | SW1  | SW2  | SW3  | SW4  | SW5  |                 | SW5  | SW4  | SW3  | SW2  | SW1  |
// | SW6  | SW7  | SW8  | SW9  | SW10 |                 | SW10 | SW9  | SW8  | SW7  | SW6  |
// | SW11 | SW12 | SW13 | SW14 | SW15 |                 | SW15 | SW14 | SW13 | SW12 | SW11 |
//               | SW16 | SW17 | SW18 |                 | SW18 | SW17 | SW16 |

        map = <
RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)          RC(12,9) RC(12,10) RC(12,11) RC(12,12) RC(12,13) RC(12,14)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)          RC(11,9) RC(11,10) RC(11,11) RC(11,12) RC(11,13) RC(11,14)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)          RC(10,9) RC(10,10) RC(10,11) RC(10,12) RC(10,13) RC(10,14)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)          RC(9, 9) RC(9 ,10) RC(9 ,11) RC(9 ,12) RC(9 ,13) RC(9 ,14)
RC(0,0) RC(0,1) RC(0,2) RC(0,4) RC(0,4)                  RC(8, 9) RC(8 ,10) RC(8 ,11) RC(8 ,12) RC(8 ,13)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

    };
};
